modules = ["nodejs-24", "postgresql-16", "php-8.3"]
run = "php artisan serve --host=0.0.0.0 --port=$PORT"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["sh", "-c", "composer install --no-interaction --prefer-dist && php artisan migrate --force && pnpm --filter @workspace/bazaar-ecommerce run build"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[nix]
channel = "stable-25_05"
