modules = ["php-8.3", "nodejs-22"]
run = "php artisan serve --host=0.0.0.0 --port=$PORT"

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["php", "artisan", "serve", "--host=0.0.0.0", "--port=$PORT"]

[deployment.env]
APP_ENV = "production"
APP_DEBUG = "false"
SESSION_DRIVER = "file"
CACHE_STORE = "file"
QUEUE_CONNECTION = "sync"
